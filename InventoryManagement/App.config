<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    DATABASE CONNECTION
    ===================
    This is the ONLY place where the database connection is configured.
    It is read by InventoryManagement.Core/Data/DatabaseConnection.cs.

      Data Source      SQL Server instance. Default: the LocalDB instance (localdb)\MSSQLLocalDB
      Initial Catalog  Database name. Default: InventoryManagementDB
      Integrated Security=True  uses your Windows login (no password is stored)

    Examples:
      SQL Server Express:  Data Source=.\SQLEXPRESS;Initial Catalog=InventoryManagementDB;Integrated Security=True;TrustServerCertificate=True
      Named LocalDB:       Data Source=(localdb)\InventoryInstance;Initial Catalog=InventoryManagementDB;Integrated Security=True

    After building, this file is copied to bin\...\InventoryManagement.dll.config.
    Edit that copy to change the connection of an already built/installed application.
  -->
  <connectionStrings>
    <add name="InventoryDb"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=InventoryManagementDB;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=30;Application Name=SmallScaleInventory"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Timeout in seconds for each database command. -->
    <add key="CommandTimeoutSeconds" value="30" />
    <!-- Log folder, relative to the application folder (or an absolute path). -->
    <add key="LogDirectory" value="Logs" />
    <!-- Number of recent entries listed under the Stock IN / Stock OUT screens. -->
    <add key="RecentTransactionCount" value="15" />
  </appSettings>

</configuration>
